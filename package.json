{
  "name": "kspromocionales-tienda",
  "version": "1.0.0",
  "description": "Tienda de productos promocionales con storytelling y conversiones por WhatsApp",
  "scripts": {
    "dev": "next dev --turbo",
    "prebuild": "node scripts/validate-unique-slugs.js && node scripts/split-products-by-category.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seo:analyze": "node scripts/analyze-gsc.mjs",
    "seo:redirects": "node scripts/build-redirect-map.mjs",
    "seo:links": "node scripts/find-broken-internal-links.mjs",
    "seo:indexability": "node scripts/audit-indexability.mjs",
    "seo:indexing": "node scripts/analyze-indexing-reasons.mjs",
    "seo:test": "node scripts/run-seo-tests.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.9.17",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "pg": "^8.21.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^6.0.3"
  }
}
